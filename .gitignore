__pycache__/
*.py[cod]
.venv/
venv/
.env
# O padrão `.env` casa só o nome exato. Backups e variantes (.env.bak,
# .env.local, .env.producao) ficavam de fora e apareciam como não rastreados,
# prontos para entrar num `git add .` com segredos dentro.
.env.*
!.env.example
*_key.txt
encryption_key.txt
a.txt
aa.txt
*.pfx
data/

# PyInstaller / instalador (gerar com scripts/build_agent_installer.ps1)
build/
# `dist/*` em vez de `dist/` porque o git nao entra em diretorio excluido: sem
# isso a excecao abaixo nunca seria avaliada.
dist/*
dist_smoke/
build_smoke/

# Excecao: o instalador avulso PRECISA estar no repositorio. O deploy e um push
# para o Render, que builda com pip num container Linux e nunca geraria um .exe
# de Windows — se ele nao viajar versionado, /instalador/baixar responde 503 em
# producao. Rebuild com scripts/build_instalador_avulso.ps1 (sem parametro para
# apontar a producao); cada rebuild adiciona ~16 MB permanentes ao historico.
!dist/Instalar_Certificado.exe

.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Pasta de backup/zip antigo (não commitar)
robot_cert-main/

# Scripts temporários de desenvolvimento
scratch/

# Logs gerados localmente
logs/
*.log

# Gerado por scripts/build_instalador_avulso.ps1 (endereco do portal no build)
agent/_build_config.py
