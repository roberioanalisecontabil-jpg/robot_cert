# Aviso no endereço antigo do portal (http://10.200.0.4:94): o link mudou.
http://:94 {
    import so_rede_interna
    root * C:/Apps/caddy/aviso-link-mudou
    header Cache-Control "no-store"
    rewrite * /index.html
    file_server
}
eventos.analisegroup.cnt.br, eventos.analisegroup.cnt.br:8191 {

    import so_cloudflare

    import portal 8197

}

zabbix.analisegroup.cnt.br, zabbix.analisegroup.cnt.br:8198 {
    # Rede interna e VPN; Let's Encrypt pelo DNS da Cloudflare (11/11/2026).
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
    }
    import so_rede_interna

    log {
        output file C:\Apps\caddy\logs\zabbix-access.log
        format json
    }

    redir / /zabbix/
    reverse_proxy 172.30.50.20:80
}