CERT_ROBOT_BASE_URL=http://127.0.0.1:8020
# CERT_ROBOT_API_KEY=  (só se o servidor tiver API_KEY definida)
AGENT_SOURCE=D:\certificados
AGENT_EXPIRED=D:\certificados_vencidos
# MACHINE_ID=pc-financeiro
INTERVAL_SEC=300
# MOVER_VENCIDOS=0

# --- Resiliência ao portal remoto (ex.: Render 503 / cold start)
# Tentativas / backoff ao ler GET /api/settings:
# AGENT_SETTINGS_RETRIES=8
# AGENT_SETTINGS_RETRY_WAIT_SEC=5
# Tentativas ao enviar POST /api/ingest:
# AGENT_INGEST_RETRIES=5
# AGENT_INGEST_RETRY_WAIT_SEC=4
# Usar últimas pastas conhecidas quando o portal cair (1=ativo):
# AGENT_USE_SETTINGS_CACHE=1
# Tempo máximo em horas para confiar no cache local (168 = 7 dias):
# AGENT_SETTINGS_CACHE_MAX_AGE_HOURS=168
# Reinício automático após falha grave não tratada, em segundos (0 = desativo):
# AGENT_RESTART_ON_FATAL_SEC=60

# --- Serviço Windows (experimental; o build do instalador gera só CertGuard_Agent.exe)
# Código em agent/service_host.py + CertGuard_Service.spec — PyInstaller manual se precisar.
