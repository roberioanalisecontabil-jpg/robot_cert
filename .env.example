# ==============================================================
# CONFIGURAÇÕES DO AGENTE - ANALISE_CERTIDIGITAL
# ==============================================================

# URL base do portal web. Se usar o Render, será o link do Render.
# Exemplo local: http://127.0.0.1:8020
CERT_ROBOT_BASE_URL=http://127.0.0.1:8020

# Se o servidor exigir chave de acesso (API_KEY), cole a mesma aqui:
CERT_ROBOT_API_KEY=

# Nome opcional para identificar essa máquina no portal
MACHINE_ID=Meu_Servidor_Windows

# Timeout HTTP (segundos). Aumente se o portal demorar (ex.: ReadTimeout no agente)
# AGENT_HTTP_CONNECT_SEC=15
# AGENT_HTTP_READ_SEC=300

# ==============================================================
# CONFIGURAÇÕES DO PORTAL (API)
# ==============================================================

# Chave estática opcional para chamadas de agente/API (header X-API-Key)
API_KEY=

# Padrão (1–2000) de linhas de cert_snapshots a agregar em histórico/vencidos
# quando o pedido omitir limite_snapshots (painel não envia este parâmetro; API CLI/testes também).
# HISTORICO_LIMITE_SNAPSHOTS=500

# Tempo de vida do cache em RAM da agregação usada em histórico/vencidos (segundos). 0 = sem cache.
# HISTORICO_CACHE_TTL_SEC=60

# Obrigatória para emissão/validação de tokens JWT do login web
JWT_SECRET_KEY=troque-por-um-segredo-longo-e-unico

# OBRIGATÓRIA: chave Fernet que cifra a senha SMTP em repouso.
# O portal NÃO SOBE sem ela — a verificação é feita no boot, de propósito.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Não é derivável da JWT_SECRET_KEY. O desenho anterior derivava, e isso
# amarrava dois segredos de propósito diferente: girar a JWT — rotina normal de
# segurança — tornava a senha SMTP gravada indecifrável, e o sintoma aparecia
# como "os alertas pararam de enviar", não como erro de chave.
#
# Precisa estar definida em TODOS os ambientes (local, Render, Vercel). Em
# serverless, defina pelo painel de variáveis — o .env não sobe no deploy.
#
# Ao TROCAR esta chave, a senha SMTP já gravada deixa de ser decifrável: rode
# `python scripts/rotate_smtp_password.py` para regravá-la com a chave nova.
ENCRYPTION_KEY=

# Segredo do disparo agendado de alertas (GET /api/cron/alerts).
#
# Necessária só no Vercel. Defina a variável CRON_SECRET no painel do projeto e
# o Vercel passa a enviar `Authorization: Bearer <CRON_SECRET>` em cada chamada
# do cron, automaticamente — não é preciso configurar o header em lugar nenhum.
#
# A rota existe porque o laço de alertas do lifespan NÃO roda em serverless:
# cada requisição instancia a função e a encerra, então o create_task morre
# antes do primeiro disparo. Sem o cron, nada dispara os alertas no Vercel.
#
# Sem esta variável a rota devolve 503 e não envia nada — falha fechada, para
# não deixar um disparo de e-mail em massa aberto a quem descobrir a URL.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=

# ==============================================================
# MÓDULO INSTALADOR DE CERTIFICADOS
# ==============================================================

# Chave AES-256 para cifrar PFX em repouso no banco (hex, 64 chars = 32 bytes).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
#
# CRÍTICO: guarde uma cópia FORA do servidor antes de armazenar o primeiro
# certificado. Perdida a chave, nenhum PFX do cofre é recuperável — nem por
# backup do banco, já que o material está cifrado com ela.
#
# Precisa estar definida em TODOS os ambientes que rodam o portal (local,
# Render, Vercel). Em plataformas serverless, defina pelo painel de variáveis
# de ambiente — o .env não sobe no deploy.
CERT_ENCRYPTION_KEY=

# Chave AES-256 da SENHA do PFX (hex, 64 chars). OBRIGATÓRIA para o instalador
# avulso — sem ela o certutil recusa todo PFX, porque a máquina do usuário final
# não tem a pasta de origem de onde o agente extrai a senha pelo nome do arquivo.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
#
# TEM DE SER DIFERENTE de CERT_ENCRYPTION_KEY. A aplicação recusa operar se
# forem iguais: guardar senha e certificado sob a mesma chave foi exatamente o
# defeito que tirou a senha do banco em 03/08 — um vazamento entregava os dois.
#
# A separação só vale se as chaves viverem em lugares distintos. As duas neste
# mesmo arquivo, no mesmo servidor, tornam a proteção nominal: quem obtiver o
# .env leva as duas. Prefira injetar esta pelo painel de variáveis do ambiente,
# ou por um cofre gerenciado, deixando só a outra aqui.
CERT_PASSWORD_ENCRYPTION_KEY=

# Rotação de chave: ao trocar CERT_ENCRYPTION_KEY, mantenha a anterior aqui
# para que os registros antigos continuem decifráveis, e suba CURRENT_KEY_VERSION
# em app/cert_installer.py. Os registros gravam a versão usada em
# cert_pfx_store.key_version, então a transição é incremental.
# CERT_ENCRYPTION_KEY_V1=

# TTL (minutos) dos tokens de instalação. Padrão: 5.
# CERT_INSTALL_TOKEN_TTL_MIN=5
